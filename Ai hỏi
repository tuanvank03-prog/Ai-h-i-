-- 🌈 VIỀN RGB
local function RainbowBorder(Object,Thickness)

    local Stroke = Instance.new("UIStroke")
    Stroke.Thickness = Thickness or 3
    Stroke.Parent = Object

    local Hue = 0

    RunService.RenderStepped:Connect(function(dt)
        Hue = (Hue + dt * 0.25) % 1
        Stroke.Color = Color3.fromHSV(Hue,1,1)
    end)
end

RainbowBorder(Main,3)
RainbowBorder(MenuButton,3)

-- 🍌 KÉO NÚT
local BananaDragging = false
local BananaDragStart
local BananaStartPos

MenuButton.InputBegan:Connect(function(input)

    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then

        BananaDragging = true
        BananaDragStart = input.Position
        BananaStartPos = MenuButton.Position
    end
end)

UIS.InputChanged:Connect(function(input)

    if BananaDragging and (
        input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch
    ) then

        local Delta = input.Position - BananaDragStart

        MenuButton.Position = UDim2.new(
            BananaStartPos.X.Scale,
            BananaStartPos.X.Offset + Delta.X,
            BananaStartPos.Y.Scale,
            BananaStartPos.Y.Offset + Delta.Y
        )
    end
end)

UIS.InputEnded:Connect(function(input)

    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then

        BananaDragging = false
    end
end)

